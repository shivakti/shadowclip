{
  "name": "ShadowClip (Compose)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "api",
  "workspaceFolder": "/workspaces/shadowclip",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/shadowclip,type=bind",
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "18"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "postCreateCommand": "bash -lc 'node -v && npm -v && python --version'"
}
